# Railway provides PORT automatically. Keep every value below in Railway Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket domain, for example: https://media.example.com
R2_PUBLIC_URL=
# Comma-separated browser origins permitted to call this API.
CORS_ORIGINS=https://social-app-inky-one.vercel.app

# Reserved for the Railway-owned authentication migration. Do not add secrets to Vercel.
AUTH_JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
